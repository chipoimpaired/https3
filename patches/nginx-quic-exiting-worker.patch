-        if (!ngx_exiting || !qc->streams.initialized) {
+        /*
+         * local: after the grace period a worker that is shutting down closes
+         * its remaining QUIC connections instead of waiting for their streams,
+         * see ngx_quic_recvmsg()
+         */
+
+        if (!ngx_exiting || !qc->streams.initialized || ngx_quic_exiting_force) {
             qc->error = NGX_QUIC_ERR_NO_ERROR;
             qc->error_reason = "graceful shutdown";
             ngx_quic_close_connection(c, NGX_ERROR);
