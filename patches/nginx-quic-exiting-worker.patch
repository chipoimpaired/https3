+/*
+ * local: QUIC listening sockets of a worker that is shutting down.
+ *
+ * After a reload the retired workers keep the QUIC listening sockets open
+ * (ngx_close_listening_sockets() skips them, their connections receive through
+ * them), and the new worker with the same number reads the very same reuseport
+ * socket.  A datagram is delivered to whichever of the two processes calls
+ * recvmsg() first, so while a retired worker is alive it takes away datagrams
+ * of the new worker's connections: handshakes time out and uploads stall.
+ * A retired worker stays alive for as long as any connection does, a websocket
+ * over TCP included, up to worker_shutdown_timeout.
+ *
+ * Without quic_bpf (which needs privileges the worker must not have) this is
+ * handled here, in the retired worker only:
+ *
+ *  - it gives the socket up as soon as none of its QUIC connections uses it,
+ *    and the datagram that woke it is left in the queue for the new worker;
+ *  - NGX_QUIC_EXITING_GRACE ms after the first datagram it sees while shutting
+ *    down, its remaining QUIC connections are closed (their HTTP/3 requests
+ *    are retried by the client on a new connection), so the socket is given up
+ *    shortly after;
+ *  - meanwhile a datagram of a connection it does not know is dropped: no
+ *    connection is created for it and nothing is sent in reply.
+ */
+
+ngx_uint_t  ngx_quic_exiting_force;
+
+static ngx_uint_t  ngx_quic_exiting_seen;
+static ngx_msec_t  ngx_quic_exiting_since;
 
 
 void
@@ -59,6 +92,37 @@
     ls = lc->listening;
     ev->ready = 0;
 
+    if (ngx_exiting) {
+
+        if (ls->rbtree.root == ls->rbtree.sentinel) {
+            ngx_quic_release_listening(ls, lc);
+            return;
+        }
+
+        if (!ngx_quic_exiting_seen) {
+            ngx_quic_exiting_seen = 1;
+            ngx_quic_exiting_since = ngx_current_msec;
+
+        } else if (!ngx_quic_exiting_force
+                   && (ngx_msec_int_t) (ngx_current_msec
+                                        - ngx_quic_exiting_since)
+                      >= NGX_QUIC_EXITING_GRACE)
+        {
+            ngx_quic_exiting_force = 1;
+
+            ngx_log_error(NGX_LOG_NOTICE, ev->log, 0,
+                          "quic closing connections of exiting worker on %V",
+                          &ls->addr_text);
+
+            ngx_close_idle_connections((ngx_cycle_t *) ngx_cycle);
+
+            if (ls->rbtree.root == ls->rbtree.sentinel) {
+                ngx_quic_release_listening(ls, lc);
+                return;
+            }
+        }
+    }
+
     ngx_log_debug2(NGX_LOG_DEBUG_EVENT, ev->log, 0,
                    "quic recvmsg on %V, ready: %d",
                    &ls->addr_text, ev->available);
