+static void
+ngx_quic_release_listening(ngx_listening_t *ls, ngx_connection_t *lc)
+{
+    ngx_event_t  *rev;
+
+    rev = lc->read;
+
+    if (rev->active) {
+        if (ngx_event_flags & NGX_USE_EPOLL_EVENT) {
+
+            /*
+             * the socket stays open in the master and in the new worker,
+             * so the event has to be deleted explicitly
+             */
+
+            ngx_del_event(rev, NGX_READ_EVENT, 0);
+
+        } else {
+            ngx_del_event(rev, NGX_READ_EVENT, NGX_CLOSE_EVENT);
+        }
+    }
+
+    if (rev->timer_set) {
+        ngx_del_timer(rev);
+    }
+
+    if (rev->posted) {
+        ngx_delete_posted_event(rev);
+    }
+
+    ngx_log_error(NGX_LOG_NOTICE, ngx_cycle->log, 0,
+                  "quic listening %V released by exiting worker",
+                  &ls->addr_text);
+
+    ngx_free_connection(lc);
+
+    lc->fd = (ngx_socket_t) -1;
+
+    if (ngx_close_socket(ls->fd) == -1) {
+        ngx_log_error(NGX_LOG_ALERT, ngx_cycle->log, ngx_socket_errno,
+                      ngx_close_socket_n " %V failed", &ls->addr_text);
+    }
+
+    ls->fd = (ngx_socket_t) -1;
+    ls->connection = NULL;
+}
+
+
 static void
 ngx_quic_close_accepted_connection(ngx_connection_t *c)
 {
