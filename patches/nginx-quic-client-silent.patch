+/*
+ * local: a client that cannot be heard any more (quic_silent_timeout).
+ *
+ * Seen on 2026-11-11 in test after test on mobile data: while an app of the
+ * phone uploads over TCP, nothing the browser of the same phone sends over UDP
+ * gets out; what the server sends still arrives.  The browser (Firefox) kept
+ * waiting on its HTTP/3 connection: requests hung for as long as the upload
+ * ran, the player gave up.  A browser moves to HTTP/2 over TCP, which the
+ * phone does let through, as soon as the server closes the connection: the
+ * requests that were waiting are repeated there by the browser itself.
+ *
+ * So: when nothing has arrived from the client for half the time, the server
+ * asks (PING), and again at three quarters of the time.  A client with
+ * nothing in progress is asked at most NGX_QUIC_LIVE_PROBES times in a row
+ * without a request in between, so that an idle client is left alone.  When
+ * nothing has arrived for the whole time although the server asked twice, the
+ * connection is closed the way a reload closes it: GOAWAY where there is
+ * HTTP/3, then CONNECTION_CLOSE without an error.
+ *
+ * The questions are sent here and do not wait for the probe timeout, and the
+ * time to answer does not follow the smoothed round trip time (second
+ * version, 2026-11-13).  A phone does not drop what the browser sends while
+ * the app uploads, it holds it and lets it out when an upload chunk ends, up
+ * to 20 s later.  Every acknowledgement that arrives that late is taken as a
+ * round trip sample, so the smoothed round trip time and the probe timeout
+ * grow to many seconds; the first version waited for two probe timeouts and
+ * then never closed such a connection (seen on production: one connection
+ * lived through every 20 s silence of an upload, the player's requests
+ * arrived in bursts of 100 and more, already given up).  The lowest round
+ * trip seen cannot be raised by late answers: a client gets half the time or
+ * four of those to answer, whichever is longer, and never more than the
+ * whole time.  So a connection is closed after 1 to 1.5 times the time.
+ *
+ * Nothing changes for a client that answers, and nothing at all while the
+ * directive is not set.
+ */
+
+static void
+ngx_quic_live_handler(ngx_event_t *ev)
+{
+    ngx_msec_t              now, silent, limit, wait;
+    ngx_connection_t       *c;
+    ngx_quic_frame_t       *f;
+    ngx_quic_send_ctx_t    *ctx;
+    ngx_quic_connection_t  *qc;
+
+    c = ev->data;
+    qc = ngx_quic_get_connection(c);
+
+    limit = qc->conf->silent_timeout;
+
+    if (limit == 0 || qc->closing || !qc->streams.initialized) {
+        return;
+    }
+
+    now = ngx_current_msec;
+    silent = now - qc->recv_time;
+
+    if (silent < limit / 2) {
+        ngx_add_timer(ev, limit / 2 - silent);
+        return;
+    }
+
+    ctx = ngx_quic_get_send_ctx(qc, NGX_QUIC_ENCRYPTION_APPLICATION);
+
+    /*
+     * the time a client has to answer the first question: not taken from
+     * the smoothed round trip time, which late answers make too long
+     */
+
+    wait = limit / 2;
+
+    if (qc->min_rtt != NGX_TIMER_INFINITE && 4 * qc->min_rtt > wait) {
+        /* a first answer that came late makes even the lowest one long */
+        wait = ngx_min(4 * qc->min_rtt, limit);
+    }
+
+    if (silent >= limit && qc->live_asked >= 2
+        && now - qc->live_ask_time >= wait)
+    {
+        ngx_log_error(NGX_LOG_INFO, c->log, 0,
+                      "quic client silent for %M ms, closing", silent);
+
+        if (qc->conf->shutdown) {
+            qc->conf->shutdown(c);
+        }
+
+        if (!qc->close.posted) {
+            /* requests are open: they cannot be delivered */
+            ngx_quic_finalize_connection(c,
+                                     qc->shutdown ? qc->shutdown_code
+                                                  : NGX_QUIC_ERR_NO_ERROR,
+                                     "client not responding");
+        }
+
+        return;
+    }
+
+    if (qc->live_asked == 0 && ngx_queue_empty(&ctx->sent)) {
+
+        /*
+         * nothing waits for an acknowledgement: a client that has nothing
+         * to say.  It is asked only so often in a row.
+         */
+
+        if (qc->live_probes >= NGX_QUIC_LIVE_PROBES) {
+            return;
+        }
+
+        qc->live_probes++;
+    }
+
+    if (qc->live_asked < NGX_QUIC_LIVE_ASKS) {
+
+        /*
+         * sent at once, like a probe of the loss timer: the congestion
+         * window may be full of what the client did not acknowledge
+         */
+
+        f = ngx_quic_alloc_frame(c);
+        if (f == NULL) {
+            return;
+        }
+
+        f->level = ctx->level;
+        f->type = NGX_QUIC_FT_PING;
+        f->ignore_congestion = 1;
+
+        if (ngx_quic_frame_sendto(c, f, 0, qc->path) == NGX_ERROR) {
+            ngx_quic_close_connection(c, NGX_ERROR);
+            return;
+        }
+
+        if (qc->live_asked == 0) {
+            qc->live_ask_time = now;
+        }
+
+        qc->live_asked++;
+    }
+
+    ngx_add_timer(ev, silent < limit ? ngx_min(limit / 4, limit - silent)
+                                     : 500);
+}
+
+
 void
 ngx_quic_close_connection(ngx_connection_t *c, ngx_int_t rc)
 {
@@ -575,6 +734,10 @@
         ngx_del_timer(&qc->pto);
     }
 
