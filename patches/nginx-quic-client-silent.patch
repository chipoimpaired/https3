+/*
+ * local: a client that cannot be heard any more (quic_silent_timeout).
+ *
+ * Seen on 2026-11-11 on two phones on two mobile networks: while an app of the
+ * phone uploads over TCP, nothing the browser of the same phone sends over UDP
+ * gets out; what the server sends still arrives.  The browser (Firefox) kept
+ * waiting on its HTTP/3 connection: requests hung for as long as the upload
+ * ran, the player gave up.  A browser moves to HTTP/2 over TCP, which the
+ * phone does let through, as soon as the server closes the connection: the
+ * requests that were waiting are repeated there by the browser itself.
+ *
+ * So: when nothing has arrived from the client for half the time and nothing
+ * the server sent waits for an acknowledgement, the server asks (PING), at
+ * most NGX_QUIC_LIVE_PROBES times in a row without a request in between, so
+ * that an idle client is left alone.  When nothing has arrived for the whole
+ * time and two probe timeouts have passed without an acknowledgement, the
+ * connection is closed the way a reload closes it: GOAWAY where there is
+ * HTTP/3, then CONNECTION_CLOSE without an error.
+ *
+ * Nothing changes for a client that answers, and nothing at all while the
+ * directive is not set.
+ */
+
+static void
+ngx_quic_live_handler(ngx_event_t *ev)
+{
+    ngx_msec_t              now, silent, limit;
+    ngx_connection_t       *c;
+    ngx_quic_frame_t       *f;
+    ngx_quic_send_ctx_t    *ctx;
+    ngx_quic_connection_t  *qc;
+
+    c = ev->data;
+    qc = ngx_quic_get_connection(c);
+
+    limit = qc->conf->silent_timeout;
+
+    if (limit == 0 || qc->closing || !qc->streams.initialized) {
+        return;
+    }
+
+    now = ngx_current_msec;
+    silent = now - qc->recv_time;
+
+    if (silent < limit / 2) {
+        ngx_add_timer(ev, limit / 2 - silent);
+        return;
+    }
+
+    ctx = ngx_quic_get_send_ctx(qc, NGX_QUIC_ENCRYPTION_APPLICATION);
+
+    if (silent >= limit && qc->pto_count >= 2) {
+
+        ngx_log_error(NGX_LOG_INFO, c->log, 0,
+                      "quic client silent for %M ms, closing", silent);
+
+        if (qc->conf->shutdown) {
+            qc->conf->shutdown(c);
+        }
+
+        if (!qc->close.posted) {
+            /* requests are open: they cannot be delivered */
+            ngx_quic_finalize_connection(c,
+                                     qc->shutdown ? qc->shutdown_code
+                                                  : NGX_QUIC_ERR_NO_ERROR,
+                                     "client not responding");
+        }
+
+        return;
+    }
+
+    if (ngx_queue_empty(&ctx->sent)) {
+
+        /*
+         * nothing waits for an acknowledgement, so nothing would show
+         * that the client cannot be heard
+         */
+
+        if (qc->live_probes >= NGX_QUIC_LIVE_PROBES) {
+            return;
+        }
+
+        f = ngx_quic_alloc_frame(c);
+        if (f == NULL) {
+            return;
+        }
+
+        f->level = ctx->level;
+        f->type = NGX_QUIC_FT_PING;
+
+        ngx_quic_queue_frame(qc, f);
+
+        qc->live_probes++;
+    }
+
+    ngx_add_timer(ev, silent < limit ? limit - silent : 500);
+}
+
+
 void
 ngx_quic_close_connection(ngx_connection_t *c, ngx_int_t rc)
 {
@@ -575,6 +687,10 @@
         ngx_del_timer(&qc->pto);
     }
 
+    if (qc->live.timer_set) {
+        ngx_del_timer(&qc->live);
+    }
+
     if (qc->path_validation.timer_set) {
         ngx_del_timer(&qc->path_validation);
     }
